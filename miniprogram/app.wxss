/* 全局样式：简洁清爽的医疗风格 */
page {
  background: #f5f7fa;
  font-size: 28rpx;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  line-height: 1.5;
  padding-bottom: 40rpx;
}

view, text, input, textarea, button {
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  margin: 20rpx 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 41, 55, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title .sub {
  font-size: 24rpx;
  font-weight: 400;
  color: #9ca3af;
}

/* 按钮 */
.btn-primary {
  background: #00b8a9;
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border: none;
  width: 100%;
}

.btn-primary::after { border: none; }

.btn-primary.disabled {
  background: #c3d3d1;
  color: #f5f7fa;
}

.btn-ghost {
  background: #ffffff;
  color: #00b8a9;
  border: 2rpx solid #00b8a9;
  border-radius: 44rpx;
  font-size: 30rpx;
  height: 84rpx;
  line-height: 80rpx;
  text-align: center;
  width: 100%;
}

.btn-ghost::after { border: none; }

.btn-danger {
  background: #ffffff;
  color: #fa5252;
  border: 2rpx solid #ffc9c9;
  border-radius: 44rpx;
  font-size: 30rpx;
  height: 84rpx;
  line-height: 80rpx;
  text-align: center;
  width: 100%;
}

.btn-danger::after { border: none; }

/* 状态标签 */
.tag {
  display: inline-block;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.tag-deposit { background: #fff4e6; color: #f59f00; }   /* 已付定金 */
.tag-tail { background: #fff0f0; color: #fa5252; }      /* 待付尾款 */
.tag-done { background: #e6fcf5; color: #00b8a9; }      /* 已结清 */
.tag-cancel { background: #f1f3f5; color: #9ca3af; }    /* 已取消 */
.tag-pending { background: #e7f0ff; color: #3b82f6; }   /* 待支付 */

/* 表单 */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.form-item:last-child { border-bottom: none; }

.form-label {
  width: 170rpx;
  color: #4b5563;
  font-size: 28rpx;
  flex-shrink: 0;
}

.form-label.required::before {
  content: '*';
  color: #fa5252;
  margin-right: 4rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
}

.form-placeholder { color: #c3c9d3; }

/* 空状态 */
.empty {
  text-align: center;
  color: #9ca3af;
  padding: 80rpx 0;
  font-size: 26rpx;
}

.empty .empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
  color: #d1d5db;
}
