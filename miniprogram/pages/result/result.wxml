<view class="page">
  <view class="result-box">
    <view class="icon-circle {{type === 'tail' ? 'tail' : ''}}">
      <view class="icon-check"></view>
    </view>
    <view class="result-title">{{title}}</view>
    <view class="result-amount">¥{{amount}}</view>
    <view class="result-tip">{{tip}}</view>
  </view>

  <view class="card info" wx:if="{{order}}">
    <view class="info-row"><text>就诊人</text><text>{{order.clientName}}</text></view>
    <view class="info-row"><text>服务时间</text><text>{{order.date}} {{order.start}}-{{order.end}}</text></view>
    <view class="info-row"><text>医院</text><text>{{order.hospital}}</text></view>
  </view>

  <view class="btn-wrap">
    <button class="btn-ghost" bindtap="goOrder">查看订单详情</button>
    <view style="height:24rpx;"></view>
    <button class="btn-primary" bindtap="goHome">返回首页</button>
  </view>
</view>
