@import '../home/home.wxss';

/* 日期条：横向滑动查看更多天（30 天） */
.strip-tip {
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 12rpx;
}

.date-strip {
  white-space: nowrap;
  padding: 6rpx 0;
}

.date-item {
  display: inline-block;
  width: 112rpx;
  text-align: center;
  margin-right: 16rpx;
  padding: 18rpx 0;
  border-radius: 14rpx;
  background: #f9fafb;
  border: 2rpx solid #f3f4f6;
}

.date-item:last-child { margin-right: 0; }

.date-item.active {
  background: #00b8a9;
  border-color: #00b8a9;
  color: #ffffff;
}

.dw { display: block; font-size: 22rpx; }
.dd { display: block; font-size: 30rpx; font-weight: 700; }

/* 日历任选日期行 */
.cal-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #4b5563;
}

.cal-icon {
  color: #00b8a9;
  font-weight: 600;
  margin-right: 16rpx;
}

.cal-text { flex: 1; }

.cal-arrow {
  color: #c3c9d3;
  font-size: 30rpx;
}

.slot {
  display: inline-block;
  width: 22%;
  margin: 1.5%;
  padding: 18rpx 0;
  border-radius: 12rpx;
  text-align: center;
  border: 2rpx solid #e5e7eb;
  background: #ffffff;
}

.slot.available {
  border-color: #00b8a9;
  color: #00b8a9;
  background: #f0fffd;
}

.slot.unavailable {
  border-color: #f3f4f6;
  background: #f3f4f6;
  color: #9ca3af;
}

.slot.booked {
  border-color: #ffc9c9;
  background: #ffe3e3;
  color: #fa5252;
}

/* 状态过滤下，不匹配状态的已约时段弱化显示 */
.slot.dim {
  opacity: 0.45;
}

.slot.pending {
  opacity: 0.6;
}

.slot-time {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
}

.slot-label {
  display: block;
  font-size: 20rpx;
  margin-top: 4rpx;
}

.legend {
  display: flex;
  justify-content: center;
  margin: 24rpx 0;
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #6b7280;
  margin: 0 16rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.dot.available { background: #00b8a9; }
.dot.unavailable { background: #d1d5db; }
.dot.booked { background: #fa5252; }

.batch-row {
  margin-top: 10rpx;
}
