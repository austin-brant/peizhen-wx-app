<view class="page">
  <view class="admin-nav">
    <view class="nav-item" bindtap="go" data-url="/pages/admin/home/home">订单</view>
    <view class="nav-item active">时间</view>
    <view class="nav-item" bindtap="go" data-url="/pages/admin/stats/stats">统计</view>
    <view class="nav-item" bindtap="go" data-url="/pages/admin/settings/settings">设置</view>
  </view>

  <view class="card">
    <view class="strip-tip">左右滑动查看更多日期，或点下方日历任选一天</view>
    <scroll-view scroll-x class="date-strip" scroll-with-animation enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollInto}}">
      <view wx:for="{{dates}}" wx:key="date" id="d-{{item.date}}" class="date-item {{selected === item.date ? 'active' : ''}}" bindtap="selectDate" data-date="{{item.date}}">
        <text class="dw">{{item.week}}</text>
        <text class="dd">{{item.day}}</text>
      </view>
    </scroll-view>
    <picker mode="date" value="{{selected}}" bindchange="changePickDate">
      <view class="cal-row">
        <text class="cal-icon">日历</text>
        <text class="cal-text">{{selected}}</text>
        <text class="cal-arrow">›</text>
      </view>
    </picker>
  </view>

  <view class="card">
    <view class="card-title">
      {{selected}} 时段
      <text class="sub">{{availableCount}} / {{daySlots.length}} 可约</text>
    </view>

    <view class="filter-bar status-bar">
      <view wx:for="{{statusFilters}}" wx:key="key" class="filter-item {{statusFilter === item.key ? 'active' : ''}}" bindtap="changeStatusFilter" data-key="{{item.key}}">{{item.label}}</view>
    </view>

    <view wx:if="{{daySlots.length}}">
      <view wx:for="{{daySlots}}" wx:key="start" class="slot {{item.status}} {{item.dim ? 'dim' : ''}} {{pendingToggle === item.start ? 'pending' : ''}}" bindtap="slotTap" data-item="{{item}}">
        <text class="slot-time">{{item.start}}-{{item.end}}</text>
        <text class="slot-label">{{item.label}}</text>
      </view>
    </view>
    <view class="empty" wx:else>请先在【设置】中配置工作时间段</view>

    <view class="legend">
      <view class="legend-item"><view class="dot available"></view>可约</view>
      <view class="legend-item"><view class="dot unavailable"></view>不可约</view>
      <view class="legend-item"><view class="dot booked"></view>已预约</view>
    </view>

    <view class="batch-row">
      <button class="btn-ghost" bindtap="blockAll" wx:if="{{!fullyBlocked}}">整日设为不可约</button>
      <button class="btn-ghost" bindtap="unblockAll" wx:else>整日设为可约</button>
    </view>
  </view>
</view>
