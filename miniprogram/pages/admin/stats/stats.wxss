@import '../home/home.wxss';

.period-bar {
  display: flex;
  margin-bottom: 16rpx;
}

.period-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #6b7280;
  background: #f9fafb;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.period-item:last-child { margin-right: 0; }

.period-item.active {
  background: #e6fcf5;
  color: #00b8a9;
  font-weight: 600;
}

.date-range {
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
}

.stat-cards { padding-bottom: 8rpx; }

.stat-row {
  display: flex;
  justify-content: space-around;
  text-align: center;
  padding: 18rpx 0;
}

.stat-row.sub-row { border-top: 1rpx solid #f3f4f6; }

.stat-cell {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.stat-cell .num {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.stat-row.sub-row .stat-cell .num { font-size: 28rpx; }

.stat-cell .label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.metric-toggle {
  display: flex;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 4rpx;
}

.metric-toggle .m {
  font-size: 24rpx;
  color: #6b7280;
  padding: 6rpx 18rpx;
  border-radius: 10rpx;
}

.metric-toggle .m.active {
  background: #ffffff;
  color: #00b8a9;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 280rpx;
  padding: 20rpx 0 10rpx;
}

.bar-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 4rpx;
}

.bar-track {
  width: 100%;
  height: 220rpx;
  background: #f3f4f6;
  border-radius: 8rpx 8rpx 0 0;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.bar {
  width: 100%;
  background: #00b8a9;
  border-radius: 8rpx 8rpx 0 0;
  min-height: 4rpx;
}

.bar-label {
  font-size: 18rpx;
  color: #9ca3af;
  margin-top: 8rpx;
  transform: scale(0.9);
}

.order-line {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  font-size: 26rpx;
}

.order-line:last-child { border-bottom: none; }

.ol-date { flex: 1.2; color: #4b5563; }
.ol-name { flex: 1; color: #111827; text-align: center; }
.ol-amount { flex: 1; color: #00b8a9; text-align: right; font-weight: 600; }
