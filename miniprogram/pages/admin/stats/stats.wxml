<view class="page">
  <view class="admin-nav">
    <view class="nav-item" bindtap="go" data-url="/pages/admin/home/home">订单</view>
    <view class="nav-item" bindtap="go" data-url="/pages/admin/slots/slots">时间</view>
    <view class="nav-item active">统计</view>
    <view class="nav-item" bindtap="go" data-url="/pages/admin/settings/settings">设置</view>
  </view>

  <view class="card">
    <view class="period-bar">
      <view wx:for="{{periods}}" wx:key="key" class="period-item {{period === item.key ? 'active' : ''}}" bindtap="changePeriod" data-key="{{item.key}}">{{item.label}}</view>
    </view>
    <view class="filter-bar status-bar">
      <view wx:for="{{statusFilters}}" wx:key="key" class="filter-item {{statusFilter === item.key ? 'active' : ''}}" bindtap="changeStatusFilter" data-key="{{item.key}}">{{item.label}}</view>
    </view>
    <block wx:if="{{period === 'custom'}}">
      <view class="custom-range">
        <picker mode="date" value="{{customStart}}" end="{{customEnd}}" bindchange="changeCustomStart">
          <view class="range-pick">{{customStart || '开始日期'}}</view>
        </picker>
        <text class="range-sep">至</text>
        <picker mode="date" value="{{customEnd}}" start="{{customStart}}" bindchange="changeCustomEnd">
          <view class="range-pick">{{customEnd || '结束日期'}}</view>
        </picker>
        <button class="range-btn" bindtap="loadStats">查询</button>
      </view>
    </block>
    <view class="date-range" wx:else>{{rangeText}}</view>
  </view>

  <view class="card stat-cards">
    <view class="stat-row">
      <view class="stat-cell"><text class="num">{{stats.orderCount}}</text><text class="label">预约单数</text></view>
      <view class="stat-cell"><text class="num">{{stats.totalHours}}</text><text class="label">服务时长(小时)</text></view>
      <view class="stat-cell"><text class="num">¥{{stats.totalAmount}}</text><text class="label">订单金额</text></view>
    </view>
  </view>

  <view class="card chart-card" wx:if="{{stats.series.length > 1}}">
    <view class="card-title">
      趋势
      <view class="metric-toggle">
        <text class="m {{metric === 'count' ? 'active' : ''}}" bindtap="changeMetric" data-m="count">单数</text>
        <text class="m {{metric === 'hours' ? 'active' : ''}}" bindtap="changeMetric" data-m="hours">时长</text>
        <text class="m {{metric === 'amount' ? 'active' : ''}}" bindtap="changeMetric" data-m="amount">金额</text>
      </view>
    </view>
    <view class="chart">
      <view wx:for="{{series}}" wx:key="key" class="bar-wrap">
        <view class="bar-track">
          <view class="bar" style="height: {{item.percent}}%;"></view>
        </view>
        <text class="bar-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">本周期订单明细 <text class="sub">共 {{orders.length}} 单</text></view>
    <view wx:if="{{orders.length}}">
      <view wx:for="{{orders}}" wx:key="id" class="order-line">
        <text class="ol-date">{{item.date}}</text>
        <text class="ol-name">{{item.clientName}}</text>
        <text class="ol-status">{{item.statusText}}</text>
        <text class="ol-amount">¥{{item.price}}</text>
      </view>
    </view>
    <view class="empty" wx:else>本周期暂无订单</view>
  </view>
</view>
