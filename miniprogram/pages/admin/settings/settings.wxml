<view class="page">
  <view class="admin-nav">
    <view class="nav-item" bindtap="go" data-url="/pages/admin/home/home">订单</view>
    <view class="nav-item" bindtap="go" data-url="/pages/admin/slots/slots">时间</view>
    <view class="nav-item" bindtap="go" data-url="/pages/admin/stats/stats">统计</view>
    <view class="nav-item active">设置</view>
  </view>

  <!-- 首页展示信息 -->
  <view class="card">
    <view class="card-title">首页展示信息</view>
    <view class="form-item"><view class="form-label">服务名称</view><input class="form-input" data-field="serviceName" value="{{form.serviceName}}" bindinput="inputChange" /></view>
    <view class="form-item"><view class="form-label">陪诊师名称</view><input class="form-input" data-field="escortName" value="{{form.escortName}}" bindinput="inputChange" /></view>
    <view class="form-item avatar-item">
      <view class="form-label">陪诊师头像</view>
      <view class="avatar-box">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseEscortAvatar">
          <image class="avatar-img" wx:if="{{escortAvatarPreview}}" src="{{escortAvatarPreview}}" mode="aspectFill" />
          <view class="avatar-img placeholder" wx:else>头像</view>
        </button>
        <view class="avatar-actions">
          <button class="avatar-act-btn" bindtap="chooseEscortImage">上传图片</button>
          <button class="avatar-act-btn clear" wx:if="{{escortAvatarPreview}}" bindtap="clearEscortAvatar">清除</button>
        </view>
      </view>
    </view>
    <view class="form-item"><view class="form-label">联系电话</view><input class="form-input" type="number" maxlength="11" data-field="phone" value="{{form.phone}}" bindinput="inputChange" /></view>
    <view class="form-item"><view class="form-label">微信号</view><input class="form-input" placeholder="首页'微信联系'按钮使用" data-field="wechatId" value="{{form.wechatId}}" bindinput="inputChange" /></view>
    <view class="form-item"><view class="form-label">客服链接</view><input class="form-input" placeholder="企业微信客服链接（选填，配置后优先跳转客服）" data-field="kfUrl" value="{{form.kfUrl}}" bindinput="inputChange" /></view>
    <view class="form-item"><view class="form-label">企业微信ID</view><input class="form-input" placeholder="企业微信 corpId（选填，与客服链接配合可直接跳转聊天）" data-field="wxCorpId" value="{{form.wxCorpId}}" bindinput="inputChange" /></view>
    <view class="form-item" style="align-items:flex-start;padding-top:26rpx;">
      <view class="form-label">公告</view>
      <textarea class="form-input" data-field="notice" value="{{form.notice}}" bindinput="inputChange" maxlength="500" auto-height style="min-height:120rpx;" />
    </view>
  </view>

  <!-- 陪诊师介绍（Markdown） -->
  <view class="card">
    <view class="card-title">陪诊师介绍 <text class="sub">首页点击陪诊师名称可查看</text></view>
    <textarea class="form-input md-textarea" placeholder="支持 Markdown 语法，例如：&#10;# 关于我&#10;**从业 5 年**，服务超 500 个家庭&#10;- 陪同挂号、取药、陪检&#10;![服务照片](https://图片链接)" data-field="about" value="{{form.about}}" bindinput="inputChange" maxlength="20000" auto-height style="min-height:280rpx;" />
    <view class="upload-row">
      <button class="btn-ghost upload-btn" bindtap="insertImage">📷 插入图片（≤500KB）</button>
    </view>
    <view class="bind-tip">支持 Markdown：# ## 标题、**加粗**、- 列表、1. 有序列表、> 引用、--- 分割线、图片 ![说明](链接)。点「插入图片」从相册选择，自动上传到服务器并插入到文末（单张不超过 500KB，超限会自动压缩）。</view>
  </view>

  <!-- 服务费用（按小时） -->
  <view class="card">
    <view class="card-title">服务费用 <text class="sub">总价 = 每小时单价 × 时长 × 折扣</text></view>
    <view class="form-item"><view class="form-label">每小时单价(元)</view><input class="form-input" type="digit" data-field="servicePrice" value="{{form.servicePrice}}" bindinput="inputChange" /></view>
  </view>

  <!-- 多级折扣 -->
  <view class="card">
    <view class="card-title">多级折扣 <text class="sub">预约时长满 X 小时自动打折，取最大可匹配档</text></view>
    <view class="list-edit" wx:if="{{discounts.length}}">
      <view wx:for="{{discounts}}" wx:key="index" class="list-edit-item">
        <text class="list-edit-name">满 {{item.hours}} 小时 {{item.rate * 10 >= 10 ? '原价' : item.rate * 10 + ' 折'}}</text>
        <text class="list-edit-del" bindtap="removeDiscount" data-key="{{item.hours}}:{{item.rate}}">删除</text>
      </view>
    </view>
    <view class="list-add discount-add">
      <input class="form-input list-add-input" type="digit" placeholder="满几小时(如 4)" value="{{newDiscountHours}}" bindinput="inputDiscountHours" />
      <input class="form-input list-add-input" type="digit" placeholder="折扣(0.9=9折)" value="{{newDiscountRate}}" bindinput="inputDiscountRate" />
      <button class="list-add-btn" bindtap="addDiscount">添加</button>
    </view>
    <view class="bind-tip">例：满4小时0.9、满8小时0.8 → 约 6 小时按 9 折、约 9 小时按 8 折。</view>
  </view>

  <!-- 工作时间段 -->
  <view class="card">
    <view class="card-title">工作时间段</view>
    <view class="form-item">
      <view class="form-label">开始时间</view>
      <picker mode="time" value="{{form.workStart}}" bindchange="changeTime" data-field="workStart">
        <view class="form-input picker">{{form.workStart}}</view>
      </picker>
    </view>
    <view class="form-item">
      <view class="form-label">结束时间</view>
      <picker mode="time" value="{{form.workEnd}}" bindchange="changeTime" data-field="workEnd">
        <view class="form-input picker">{{form.workEnd}}</view>
      </picker>
    </view>
    <view class="form-item">
      <view class="form-label">每段时长</view>
      <picker mode="selector" range="{{slotOptions}}" value="{{slotIndex}}" bindchange="changeSlot">
        <view class="form-input picker">{{slotOptions[slotIndex]}} 分钟</view>
      </picker>
    </view>
    <view class="slot-preview" wx:if="{{slotPreview}}">{{slotPreview}}</view>
  </view>

  <!-- 候选医院 -->
  <view class="card">
    <view class="card-title">候选医院 <text class="sub">预约填单下拉选择，也可手输</text></view>
    <view class="list-edit" wx:if="{{hospitals.length}}">
      <view wx:for="{{hospitals}}" wx:key="*this" class="list-edit-item">
        <text class="list-edit-name">{{item}}</text>
        <text class="list-edit-del" bindtap="removeHospital" data-name="{{item}}">删除</text>
      </view>
    </view>
    <view class="list-add">
      <input class="form-input list-add-input" placeholder="输入医院名称后添加" value="{{newHospital}}" bindinput="inputHospital" />
      <button class="list-add-btn" bindtap="addHospital">添加</button>
    </view>
  </view>

  <!-- 备注快捷选项 -->
  <view class="card">
    <view class="card-title">备注快捷选项 <text class="sub">预约填单点选填入</text></view>
    <view class="list-edit" wx:if="{{noteOptions.length}}">
      <view wx:for="{{noteOptions}}" wx:key="*this" class="list-edit-item">
        <text class="list-edit-name">{{item}}</text>
        <text class="list-edit-del" bindtap="removeNote" data-name="{{item}}">删除</text>
      </view>
    </view>
    <view class="list-add">
      <input class="form-input list-add-input" placeholder="如：老人行动不便" value="{{newNote}}" bindinput="inputNote" />
      <button class="list-add-btn" bindtap="addNote">添加</button>
    </view>
  </view>

  <!-- 管理员微信白名单 -->
  <view class="card">
    <view class="card-title">管理员微信白名单 <text class="sub">白名单微信 + 正确密码可登录管理端</text></view>
    <view class="list-edit" wx:if="{{adminOpenidItems.length}}">
      <view wx:for="{{adminOpenidItems}}" wx:key="full" class="list-edit-item">
        <text class="list-edit-name">{{item.short}}</text>
        <text class="list-edit-tag" wx:if="{{item.full === myOpenid}}">当前微信</text>
        <text class="list-edit-del" bindtap="removeOpenid" data-openid="{{item.full}}">删除</text>
      </view>
    </view>
    <view class="list-add">
      <button class="list-add-btn whitelist-btn" bindtap="addMeToWhitelist" disabled="{{!myOpenid || myInList}}">{{myInList ? '当前微信已在白名单' : '把当前微信加入白名单'}}</button>
    </view>
    <view class="list-add">
      <input class="form-input list-add-input" placeholder="粘贴对方 openid 手动添加" value="{{newOpenid}}" bindinput="inputNewOpenid" />
      <button class="list-add-btn" bindtap="addOpenidByInput">添加</button>
    </view>
    <view class="bind-tip">白名单内微信登录一次后即可一键进入管理端。对方 openid 在其管理登录页点击「复制 openid」获取。首个管理员需先在服务器上配置（直改 config.json 的 adminOpenids）。</view>
  </view>

  <!-- 安全 -->
  <view class="card">
    <view class="card-title">安全</view>
    <view class="form-item"><view class="form-label">新管理密码</view><input class="form-input" password placeholder="留空表示不修改" data-field="adminPassword" value="{{form.adminPassword}}" bindinput="inputChange" /></view>
  </view>

  <view class="save-row">
    <button class="btn-primary" bindtap="save">保存设置</button>
  </view>

  <view class="logout-row">
    <button class="btn-danger" bindtap="logout">退出管理端</button>
  </view>
</view>
