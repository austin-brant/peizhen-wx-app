.login-card {
  background: #ffffff;
  border-radius: 24rpx;
  margin: 120rpx 40rpx;
  padding: 48rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.login-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #111827;
  text-align: center;
}

.login-tip {
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
  margin: 12rpx 0 40rpx;
}

.login-input {
  width: 100%;
  height: 92rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  margin-bottom: 40rpx;
  box-sizing: border-box;
}

.wechat-login-btn {
  margin-bottom: 40rpx;
}

.divider {
  display: flex;
  align-items: center;
  color: #9ca3af;
  font-size: 24rpx;
  margin-bottom: 40rpx;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #f3f4f6;
  margin: 0 20rpx;
}

/* 当前微信卡片 */
.wx-card {
  background: #f0fdfa;
  border: 1rpx solid #99f6e4;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
}

.wx-card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.wx-card-label {
  font-size: 26rpx;
  color: #374151;
  font-weight: 600;
}

.wx-card-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.wx-card-status.ok {
  color: #047857;
  background: #d1fae5;
}

.wx-card-status.no {
  color: #b45309;
  background: #fef3c7;
}

.wx-card-id {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.openid-text {
  font-size: 24rpx;
  color: #111827;
  font-family: Menlo, monospace;
  word-break: break-all;
  flex: 1;
  margin-right: 16rpx;
}

.copy-btn {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
  line-height: 48rpx;
  background: #ffffff;
  color: #0d9488;
  border: 1rpx solid #14b8a6;
  border-radius: 999rpx;
}

.wx-card-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #b45309;
  line-height: 1.5;
}

.login-foot {
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
}
