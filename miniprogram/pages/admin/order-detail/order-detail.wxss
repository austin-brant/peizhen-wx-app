/* 管理端订单详情 */
/* 页面骨架：内容区自适应，底栏吸附底部（占位不遮挡内容，页面可正常滚动） */
page {
  padding-bottom: 0;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.content {
  flex: 1 0 auto;
}

.safe-gap {
  height: 24rpx;
}

.status-card {
  background: linear-gradient(135deg, #00b8a9 0%, #00a3b8 100%);
  color: #ffffff;
  padding: 48rpx 36rpx;
  border-radius: 0 0 40rpx 40rpx;
  margin: -20rpx -24rpx 20rpx -24rpx;
}

.status-title {
  font-size: 40rpx;
  font-weight: 700;
}

.status-desc {
  font-size: 26rpx;
  margin-top: 12rpx;
  opacity: 0.95;
  line-height: 1.5;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 26rpx;
}

.info-row text:first-child { color: #6b7280; }
.info-row text:last-child { color: #111827; }
.info-row .strong { font-weight: 600; }
.info-row .sub-text { color: #9ca3af; }

.money-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #4b5563;
}

.money-row .money {
  color: #fa5252;
  font-size: 40rpx;
  font-weight: 700;
}

.fee-line {
  font-size: 24rpx;
  color: #9aa3b2;
  padding: 6rpx 0;
  line-height: 1.6;
}

.fee-tip {
  margin-top: 10rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f3f4f6;
  font-size: 24rpx;
  color: #9aa3b2;
  line-height: 1.6;
}

/* 下单用户资料卡（基于 openid 关联，头像昵称由用户主动填写） */
.user-head {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f0fffd;
  flex: none;
}

.user-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.user-meta {
  margin-left: 24rpx;
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.user-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.contact-row {
  display: flex;
  flex-direction: column;
}

.contact-btn {
  margin-bottom: 20rpx;
  font-size: 28rpx;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
}

.contact-btn::after { border: none; }

.contact-btn.phone {
  background: #e6fcf5;
  color: #00b8a9;
  border: 2rpx solid #00b8a9;
}

/* 底栏：sticky 吸附底部，同时占据文档流高度，不再遮挡底部内容 */
.bottom-bar {
  position: sticky;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 20;
  flex: none;
  background: #ffffff;
  padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.bottom-bar button {
  margin-bottom: 16rpx;
}

.bottom-bar button:last-child {
  margin-bottom: 0;
}
