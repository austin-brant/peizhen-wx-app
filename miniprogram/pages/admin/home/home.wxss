/* 管理端公共导航，复用于各 admin 页面 */
.admin-nav {
  display: flex;
  background: #ffffff;
  border-bottom: 1rpx solid #f3f4f6;
  margin: -20rpx -24rpx 20rpx -24rpx;
  padding: 0 24rpx;
}

.nav-item {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 28rpx;
  color: #6b7280;
  position: relative;
}

.nav-item.active {
  color: #00b8a9;
  font-weight: 600;
}

.nav-item.active::after {
  content: '';
  position: absolute;
  left: 20%;
  right: 20%;
  bottom: 0;
  height: 4rpx;
  background: #00b8a9;
  border-radius: 4rpx;
}

.summary {
  background: linear-gradient(135deg, #f0fffd 0%, #ffffff 100%);
  border: 1rpx solid #e6fcf5;
}

.summary-title {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 20rpx;
}

.summary-row {
  display: flex;
  justify-content: space-around;
  text-align: center;
}

.summary-cell {
  display: flex;
  flex-direction: column;
}

.summary-cell .num {
  font-size: 38rpx;
  font-weight: 700;
  color: #111827;
}

.summary-cell .label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.filter-bar {
  display: flex;
  margin-bottom: 20rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #6b7280;
  background: #f9fafb;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.filter-item:last-child { margin-right: 0; }

/* 日历选日期（picker 作为 flex 子项） */
.filter-bar picker {
  flex: 1;
  display: block;
  margin-left: 16rpx;
}

.filter-bar picker .filter-item {
  width: 100%;
  box-sizing: border-box;
  margin-right: 0;
  white-space: nowrap;
  overflow: hidden;
}

.filter-item.active {
  background: #e6fcf5;
  color: #00b8a9;
  font-weight: 600;
}

.order-row {
  display: flex;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.order-row:last-child { border-bottom: none; }

.order-time {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.row-arrow {
  color: #c3c9d3;
  font-weight: 400;
}

.order-info {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

.order-amount {
  font-size: 24rpx;
  color: #00b8a9;
  margin-top: 8rpx;
}

.order-dur { color: #9aa3b2; }

.order-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
}

.action-btn {
  margin-top: 12rpx;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  line-height: 1.4;
  background: transparent;
}

.action-btn::after { border: none; }

.action-btn.primary {
  background: #00b8a9;
  color: #ffffff;
}

.action-btn.confirm {
  background: #e7f0ff;
  color: #3b82f6;
}

.action-btn.danger {
  background: #fff0f0;
  color: #fa5252;
}

.action-btn.delete {
  background: #f1f3f5;
  color: #9ca3af;
}

/* 状态过滤条（第二行） */
.status-bar {
  margin-top: -8rpx;
}
