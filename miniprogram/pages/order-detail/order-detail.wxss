.status-card {
  background: linear-gradient(135deg, #00b8a9 0%, #00a3b8 100%);
  color: #ffffff;
  padding: 48rpx 36rpx;
  border-radius: 0 0 40rpx 40rpx;
  margin: -20rpx -24rpx 20rpx -24rpx;
}

.status-title {
  font-size: 40rpx;
  font-weight: 700;
}

.status-desc {
  font-size: 26rpx;
  margin-top: 12rpx;
  opacity: 0.95;
  line-height: 1.5;
}

.timeline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.tl-item {
  text-align: center;
  color: #d1d5db;
  flex-shrink: 0;
}

.tl-item.done { color: #00b8a9; }

.tl-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #e5e7eb;
  margin: 0 auto 12rpx;
}

.tl-item.done .tl-dot { background: #00b8a9; }

.tl-text { font-size: 22rpx; }

.tl-line {
  flex: 1;
  height: 4rpx;
  background: #e5e7eb;
  margin: 0 10rpx;
  margin-bottom: 34rpx;
}

.tl-line.done { background: #00b8a9; }

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 26rpx;
}

.info-row text:first-child { color: #6b7280; }
.info-row text:last-child { color: #111827; }

.money-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #4b5563;
}

.money-row.total {
  border-top: 2rpx solid #f3f4f6;
  margin-top: 10rpx;
  padding-top: 20rpx;
  font-weight: 700;
  font-size: 30rpx;
}

.money-row .amount { color: #fa5252; }
.money-row .done { color: #00b8a9; }

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
}
