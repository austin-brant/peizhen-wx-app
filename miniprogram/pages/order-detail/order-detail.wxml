<view class="page" wx:if="{{order}}">
  <view class="content">
  <view class="status-card">
    <view class="status-title">{{statusText.text}}</view>
    <view class="status-desc">{{statusDesc}}</view>
  </view>

  <!-- 进度条 -->
  <view class="card">
    <view class="card-title">服务进度</view>
    <view class="timeline">
      <view class="tl-item {{step.submit ? 'done' : ''}}">
        <view class="tl-dot"></view>
        <view class="tl-text">提交预约</view>
      </view>
      <view class="tl-line {{step.service ? 'done' : ''}}"></view>
      <view class="tl-item {{step.service ? 'done' : ''}}">
        <view class="tl-dot"></view>
        <view class="tl-text">服务完成</view>
      </view>
    </view>
  </view>

  <!-- 信息 -->
  <view class="card">
    <view class="card-title">预约信息</view>
    <view class="info-row"><text>服务时间</text><text>{{order.date}} {{order.start}}-{{order.end}}</text></view>
    <view class="info-row"><text>服务时长</text><text>{{order.durationHours}} 小时{{order.slotCount > 1 ? '（' + order.slotCount + '个时段）' : ''}}</text></view>
    <view class="info-row"><text>预约人</text><text>{{order.bookerName || order.clientName}}</text></view>
    <view class="info-row"><text>手机号</text><text>{{order.bookerPhone || order.clientPhone}}</text></view>
    <view class="info-row" wx:if="{{order.forOthers}}"><text>就诊人</text><text>{{order.clientName}}</text></view>
    <view class="info-row" wx:if="{{order.forOthers}}"><text>就诊人手机号</text><text>{{order.clientPhone}}</text></view>
    <view class="info-row"><text>就诊医院</text><text>{{order.hospital}}</text></view>
    <view class="info-row" wx:if="{{order.department}}"><text>科室</text><text>{{order.department}}</text></view>
    <view class="info-row" wx:if="{{order.notes}}"><text>备注</text><text>{{order.notes}}</text></view>
  </view>

  <!-- 费用 -->
  <view class="card" wx:if="{{order.price}}">
    <view class="card-title">费用参考</view>
    <view class="money-row"><text>服务费用</text><text>¥{{order.price}}</text></view>
    <view class="fee-tip">预约免费，费用为陪诊服务参考价，具体以实际服务为准。</view>
  </view>

  <view class="safe-gap"></view>
  </view>

  <!-- 操作栏 -->
  <view class="bottom-bar">
    <button class="btn-ghost" wx:if="{{order.status !== 'completed' && order.status !== 'finished' && order.status !== 'cancelled' && escortPhone}}" bindtap="callEscort">联系陪诊师</button>
    <button class="btn-danger" wx:if="{{order.status !== 'completed' && order.status !== 'finished' && order.status !== 'cancelled'}}" bindtap="cancelOrder">取消预约</button>
  </view>
</view>
