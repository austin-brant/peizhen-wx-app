/* 页面骨架：内容区自适应，底栏吸附在底部（占位不遮挡内容，可正常滚动） */
page {
  padding-bottom: 0;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.content {
  flex: 1 0 auto;
}

/* 内容区与底栏之间的收尾留白，防止最后一行贴住按钮 */
.safe-gap {
  height: 24rpx;
}

.form-textarea {
  height: 160rpx;
  line-height: 1.6;
  padding: 6rpx 0;
  width: 100%;
}

/* 微信授权一键获取手机号按钮 */
.phone-get-btn {
  flex: none;
  width: auto;
  height: 56rpx;
  line-height: 56rpx;
  margin: 0;
  padding: 0 22rpx;
  font-size: 24rpx;
  color: #00b8a9;
  background: #f0fffd;
  border: 2rpx solid #00b8a9;
  border-radius: 999rpx;
  text-align: center;
}

.phone-get-btn::after { border: none; }

.summary { padding-bottom: 16rpx; }

.sum-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.sum-row:last-child { border-bottom: none; }

.sum-label {
  color: #6b7280;
  font-size: 28rpx;
}

.sum-val {
  color: #111827;
  font-size: 28rpx;
  font-weight: 600;
}

.sum-val.deposit { color: #00b8a9; }

.sum-val.discount { color: #fa5252; font-weight: 500; }

.sum-val.total { color: #00b8a9; font-size: 32rpx; }

.sum-origin { color: #9ca3af; font-size: 24rpx; font-weight: 400; }

.agreement {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #4b5563;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  flex: none;
  border: 2rpx solid #d1d5db;
  border-radius: 50%;
  margin-right: 14rpx;
  position: relative;
}

.checkbox.checked {
  background: #00b8a9;
  border-color: #00b8a9;
}

.checkbox.checked::after {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 2rpx;
  width: 8rpx;
  height: 16rpx;
  border: 4rpx solid #ffffff;
  border-top: none;
  border-left: none;
  transform: rotate(45deg);
}

/* 「为他人预约」勾选行 */
.others-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0 8rpx;
  font-size: 26rpx;
  color: #4b5563;
}

.link {
  color: #00b8a9;
  margin-left: 6rpx;
}

/* 底栏：sticky 吸附底部，同时占据文档流高度，不再遮挡内容、不影响勾选 */
.bottom-bar {
  position: sticky;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 20;
  flex: none;
  background: #ffffff;
  padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.cancel-btn {
  margin-top: 16rpx;
}

/* ============ 医院选择 & 快捷备注 ============ */
.picker.placeholder {
  color: #c3c9d3;
}

.note-chips {
  display: flex;
  flex-wrap: wrap;
}

.note-chip {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #f0fffd;
  color: #0f766e;
  font-size: 26rpx;
  margin: 0 16rpx 16rpx 0;
  border: 2rpx solid #b2ece5;
}

.note-chip.active {
  background: #00b8a9;
  border-color: #00b8a9;
  color: #ffffff;
}
